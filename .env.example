# testnet (default) or mainnet.
# The fiber image copies its bundled config on first start:
#   testnet  (default template)
#   mainnet  FIBER_CONFIG_TEMPLATE=/usr/local/share/fiber/config/mainnet/config.yml
# A store cannot change chains. To switch, stop the stack and move ./fiber-node aside.
FIBER_NETWORK=testnet

# Trusted CKB RPC. Required for mainnet: the bundled config uses
# http://127.0.0.1:8114/, which the container cannot reach. Written into
# fiber-node/config.yml only while that placeholder is still present.
# Testnet ignores this and uses the bundled https://testnet.ckbapp.dev/.
CKB_RPC_URL=https://your-mainnet-ckb-rpc/

FIBER_SECRET_KEY_PASSWORD=replace-with-a-strong-password
RUST_LOG=info

TWINE_NOSTR_SECRET=hex-or-nsec-daemon-key
# Relays this daemon uses. The store app has none built in. Startup logs
# this daemon's npub; people paste that npub and this list into the app.
TWINE_RELAYS=wss://relay.damus.io,wss://nos.lol
TWINE_RPC=http://127.0.0.1:8227
# Biscuit for that RPC, sent as `Authorization: Bearer`. The node checks it
# against rpc.biscuit_public_key. The token needs:
#   read("node");
#   read("invoices"); write("invoices");
#   read("payments"); write("payments");
#   node("<this fnn pubkey>");
#   write("watchtower");
# `create_preimage` refuses a token that has no node fact.
TWINE_RPC_TOKEN=

# Nostr pubkey allowed to resolve a dispute. Dispute is refused while this is empty.
TWINE_SOLVER=
