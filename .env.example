# The daemon reads the process environment. It does not open this file.
#   set -a && source .env && set +a
# A VPS unit loads the same variables through systemd. See DEPLOY.md.

# testnet (default) or mainnet. Must match the Fiber node.
FIBER_NETWORK=testnet
RUST_LOG=info

# Hex or nsec. Startup logs the matching npub.
TWINE_NOSTR_SECRET=hex-or-nsec-daemon-key
# Comma-separated websocket URLs. At least one.
TWINE_RELAYS=wss://relay.damus.io,wss://nos.lol
TWINE_RPC=http://127.0.0.1:8227
# Biscuit sent as Authorization: Bearer. Minting is in the README.
TWINE_RPC_TOKEN=

# Hex Nostr pubkey allowed to send resolve. Empty refuses disputes.
TWINE_SOLVER=
